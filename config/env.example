# Runtime
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# MySQL/TiDB used by the application.
EXTERNAL_DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000
DB_KEEP_ALIVE_MS=10000
DB_SLOW_QUERY_MS=1000

# Backup/maintenance. Use a directory outside the repository for real data.
BACKUP_DIR=backups/daily
BACKUP_RETENTION_DAYS=14
BACKUP_COPY_DIR=

# Cron/maintenance callback. Send Authorization: Bearer <value>.
SCHEDULE_SECRET=replace-with-a-long-random-schedule-secret
# Optional generic webhook for backup/maintenance alerts.
ALERT_WEBHOOK_URL=

# Optional S3-compatible storage: AWS S3, Cloudflare R2, MinIO, Backblaze, etc.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Optional direct Google Maps JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=

# Asaas (deixe em mock até a integração real)
ASAAS_ENVIRONMENT=mock
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=


# E-mail (preparado; por padrão só registra no log até configurar a nova hospedagem)
# EMAIL_PROVIDER=console|resend|webhook
EMAIL_PROVIDER=console
EMAIL_FROM=PromotoresSaaS <noreply@seudominio.com>
ADMIN_NOTIFICATION_EMAIL=ivan.honemann@gmail.com
APP_PUBLIC_URL=https://promotores-saas-teste.vercel.app
# Quando migrar: use o gateway da nova hospedagem (webhook) ou Resend
EMAIL_WEBHOOK_URL=
RESEND_API_KEY=
