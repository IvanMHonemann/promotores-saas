{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "corepack enable && pnpm install",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|robots\\.txt$|sitemap\\.xml$|og-image\\.png$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scheduled/database-maintenance",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/scheduled/database-maintenance",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/scheduled/database-maintenance",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/scheduled/archive-timesheets",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/scheduled/database-backup",
      "schedule": "30 5 * * *"
    }
  ]
}
