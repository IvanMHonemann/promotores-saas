{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "corepack enable && pnpm install",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/api"
    }
  ]
}